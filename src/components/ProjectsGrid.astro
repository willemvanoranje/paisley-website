---
const apiUrl = import.meta.env.PUBLIC_PORTFOLIO_API_URL || "";
---

<div id="projects-container" data-api-url={apiUrl}>
  <div id="projects-loading" class="space-y-12">
    {Array.from({ length: 2 }).map(() => (
      <div class="grid grid-cols-[minmax(0,2fr)_minmax(5rem,1fr)] gap-2 sm:gap-4">
        <div class="w-full rounded-sm bg-gray-100 animate-pulse" style="aspect-ratio: 4/3;" />
        <div class="grid grid-rows-4 gap-2">
          {Array.from({ length: 4 }).map(() => <div class="rounded-sm bg-gray-100 animate-pulse" />)}
        </div>
      </div>
    ))}
  </div>
  <div id="projects-grid" class="hidden space-y-12 sm:space-y-16"></div>
  <p id="projects-empty" class="hidden text-center text-gray-400 py-16 text-lg">
    No projects yet — check back soon!
  </p>
  <p id="projects-error" class="hidden text-center text-red-400 py-16 text-sm">
    Could not load projects. Please try refreshing.
  </p>
</div>

<script>
  interface ProjectImage {
    src: string;
    alt: string;
    palette: string[];
  }

  function paletteTextColor(hex: string) {
    const red = parseInt(hex.slice(1, 3), 16);
    const green = parseInt(hex.slice(3, 5), 16);
    const blue = parseInt(hex.slice(5, 7), 16);
    const luminance = (red * 299 + green * 587 + blue * 114) / 1000;
    return luminance > 150 ? "#1f2937" : "#ffffff";
  }

  async function loadProjects() {
    const container = document.getElementById("projects-container")!;
    const apiUrl = container.getAttribute("data-api-url");
    const loadingEl = document.getElementById("projects-loading")!;
    const gridEl = document.getElementById("projects-grid")!;
    const emptyEl = document.getElementById("projects-empty")!;
    const errorEl = document.getElementById("projects-error")!;

    if (!apiUrl) {
      loadingEl.classList.add("hidden");
      emptyEl.classList.remove("hidden");
      return;
    }

    try {
      const response = await fetch(`${apiUrl}/api/projects`);
      if (!response.ok) throw new Error("API returned " + response.status);
      const data = await response.json();
      const images: ProjectImage[] = data.images || [];

      loadingEl.classList.add("hidden");
      if (images.length === 0) {
        emptyEl.classList.remove("hidden");
        return;
      }

      images.forEach((image, index) => {
        const figure = document.createElement("figure");
        figure.className = "space-y-3";

        const visual = document.createElement("div");
        visual.className = "grid grid-cols-[minmax(0,2fr)_minmax(5rem,1fr)] gap-2 sm:gap-4 items-stretch";

        const button = document.createElement("button");
        button.className =
          "gallery-item block w-full overflow-hidden rounded-sm cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400";
        button.setAttribute("data-index", String(index));
        button.setAttribute("data-src", image.src);
        button.setAttribute("data-alt", image.alt);

        const photo = document.createElement("img");
        photo.src = image.src;
        photo.alt = image.alt;
        photo.loading = index < 2 ? "eager" : "lazy";
        photo.decoding = "async";
        photo.className = "block w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]";
        button.appendChild(photo);

        const palette = document.createElement("div");
        palette.className = "grid grid-rows-4 gap-2 sm:gap-4";
        palette.setAttribute("aria-label", `Color palette for ${image.alt || "project image"}`);

        image.palette.forEach((color) => {
          const swatch = document.createElement("div");
          swatch.className = "rounded-sm flex items-end justify-end p-1.5 sm:p-3";
          swatch.style.backgroundColor = color;

          const label = document.createElement("span");
          label.className = "font-display text-[9px] sm:text-xs tracking-wide";
          label.style.color = paletteTextColor(color);
          label.textContent = color;
          swatch.appendChild(label);
          palette.appendChild(swatch);
        });

        visual.append(button, palette);
        figure.appendChild(visual);

        if (image.alt) {
          const caption = document.createElement("figcaption");
          caption.className = "font-display text-xs tracking-widest uppercase text-gray-500";
          caption.textContent = image.alt;
          figure.appendChild(caption);
        }
        gridEl.appendChild(figure);
      });

      gridEl.classList.remove("hidden");
      document.dispatchEvent(new CustomEvent("gallery:loaded"));
    } catch (error) {
      console.error("Failed to load projects:", error);
      loadingEl.classList.add("hidden");
      errorEl.classList.remove("hidden");
    }
  }

  loadProjects();
</script>
