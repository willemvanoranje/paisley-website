---
import Layout from "../layouts/Layout.astro";
import Lightbox from "../components/Lightbox.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
---

<Layout title="Paisley — Projects">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="mb-10 sm:mb-14">
      <h1 class="font-display text-3xl sm:text-4xl font-light tracking-wide text-gray-900">
        Projects
      </h1>
      <p class="mt-3 max-w-2xl text-sm sm:text-base leading-relaxed text-gray-500">
        Photography studies paired with the colors that shape them.
      </p>
    </div>
    <ProjectsGrid />
  </section>
  <Lightbox />
</Layout>
